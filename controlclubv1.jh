application {
  config {
    baseName ControlPagoMensual,
    applicationType monolith,
    authenticationType jwt,
    packageName com.example.controlpagomensual,
    prodDatabaseType postgresql,
    buildTool maven,
    enableSwaggerCodegen true,
    enableTranslation false,
    nativeLanguage es
  }
  entities Usuario, Pago, Notificacion, HistorialPago
}

entity Usuario {
  nombre String required,
  direccion String required,
  correoElectronico String required,
  telefono String required,
  identificacion String required,
  rol RolUsuario required
}

enum RolUsuario {
  ADMINISTRADOR,
  USUARIO
}

entity Pago {
  descripcion String required,
  monto BigDecimal required,
  fechaPago Instant required,
  estadoPago EstadoPago required,
  referencia String required,
  metodoPago MetodoPago required,
  usuario Usuario required,
  historialPago HistorialPago
}

enum EstadoPago {
  PENDIENTE,
  COMPLETADO,
  VENCIDO
}

enum MetodoPago {
  CHEQUE,
  TRANSFERENCIA,
  EFECTIVO
}

entity HistorialPago {
  idPago Long required,
  fechaPago Instant required,
  monto BigDecimal required,
  estadoPago EstadoPago required
}

entity Notificacion {
  mensaje String required,
  tipoNotificacion TipoNotificacion required,
  fechaEnvio Instant required,
  usuario Usuario required
}

enum TipoNotificacion {
  WHATSAPP,
  CORREO_ELECTRONICO,
  SMS
}

relationship ManyToOne {
  Pago{usuario} to Usuario
  Notificacion{usuario} to Usuario
  HistorialPago{pago} to Pago
}

service Usuario, Pago, Notificacion with serviceClass

paginate Pago, Notificacion, HistorialPago with pagination